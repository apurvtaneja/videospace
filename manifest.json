{
  "manifest_version": 3,
  "name": "VideoSpace",
  "version": "1.0.0",
  "description": "Fullscreen YouTube videos open in their own macOS Space, and the tab slides back into its window when you exit.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/main-world-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/fullscreen-controller.js"],
      "run_at": "document_start"
    }
  ]
}
